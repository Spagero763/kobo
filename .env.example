# Copy to .env and fill in. .env is gitignored and must never be committed.

# Wallet Kobo transacts from on Celo mainnet.
AGENT_ADDRESS=0xE23c44Dd4a51456786c6681cFE928AAcfa00d619
AGENT_PRIVATE_KEY=

# ERC-8021 attribution suffix, issued at registration.
ATTRIBUTION_TAG=

# Public URL of the deployed app. Used for the agent card and callbacks.
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

CELO_RPC=https://forno.celo.org
